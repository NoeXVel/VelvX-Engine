## Ponto de entrada do jogo 2D.
## Main() roda uma vez, quando o Play começa.
## InGame() roda a cada quadro — ideal para inputs e movimento.

func Main()
{
    console.show("VelvX 2D pronta. Use WASD ou as setas para mover o Player2D.");
    console.show("Pressione E para carregar a Floresta por streaming.");
}

func InGame()
{
    ## Ordem dos argumentos: positivo X, negativo X, positivo Y, negativo Y.
    ## Os nomes abaixo são ações do projeto — edite em Projeto > Configurações > Entradas.
    var direcao = game.get_input_vectors("mover_direita", "mover_esquerda", "mover_cima", "mover_baixo");
    this.CharacterBody2D.velocity = new.Vector2(direcao.x * 5, direcao.y * 5);

    ## Streaming de nível: carrega a Floresta uma única vez.
    if game.get_input("interagir") and not Scene("Floresta").is_loaded()
    {
        Scene("Floresta").load();
        console.show("Floresta carregada por streaming.");
    }
}
