<Window x:Class="VelvX.Engine.Windows.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher cor"
        Width="430" Height="626" MinWidth="430" MinHeight="626"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource EditorBg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Text="ESCOLHER COR" Style="{StaticResource SectionLabel}" Margin="0" />
      <TextBlock Text="Clique na roda para escolher o tom e a saturação. Ajuste o brilho na barra."
                 FontSize="10" Foreground="#8A8E9E" Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" Width="252" Height="252" HorizontalAlignment="Center" Margin="0,0,0,10">
      <Image x:Name="WheelImage" Cursor="Hand"
             MouseLeftButtonDown="Wheel_MouseLeftButtonDown"
             MouseMove="Wheel_MouseMove"
             MouseLeftButtonUp="Wheel_MouseLeftButtonUp" />
      <Canvas Width="252" Height="252" IsHitTestVisible="False">
        <Ellipse x:Name="WheelMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2"
                 Fill="Transparent" />
      </Canvas>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <DockPanel Margin="0,0,0,4">
        <TextBlock x:Name="ValueLabel" Text="BRILHO  100%" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
        <TextBlock Text="escuro → claro" DockPanel.Dock="Right" FontSize="9" Foreground="#6F7382" VerticalAlignment="Center" />
      </DockPanel>
      <Border x:Name="ValueBar" Height="12" CornerRadius="6" BorderBrush="#3A3E4C" BorderThickness="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="#000000" />
            <GradientStop Offset="1" Color="#FFFFFF" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>
      <Slider x:Name="ValueSlider" Minimum="0" Maximum="100" Value="100" Margin="0,6,0,0"
              ValueChanged="ValueSlider_ValueChanged" />
    </StackPanel>

    <DockPanel Grid.Row="3" Margin="0,0,0,12">
      <Border x:Name="PreviewSwatch" DockPanel.Dock="Right" Width="58" Height="40" CornerRadius="8"
              Background="#A98BFF" BorderBrush="#3A3E4C" BorderThickness="1" Margin="10,0,0,0" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="COR SELECIONADA (HEX)" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="HexField" FontSize="12" Padding="8,6" MinHeight="30"
                 TextChanged="HexField_TextChanged" KeyDown="HexField_KeyDown" />
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="4">
      <TextBlock Text="PALETA RÁPIDA" Style="{StaticResource FieldLabel}" />
      <WrapPanel x:Name="PalettePanel" />
    </StackPanel>

    <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Usar esta cor"
              Padding="16,9" Click="Ok_Click" />
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancelar"
              Padding="12,8" Margin="0,0,8,0" Click="Cancel_Click" />
    </DockPanel>
  </Grid>
</Window>
