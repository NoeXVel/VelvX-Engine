<Window x:Class="VelvX.Engine.Windows.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materiais"
        Width="800" Height="620" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource EditorBg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="*" />
      <RowDefinition Height="62" />
    </Grid.RowDefinitions>

    <Border Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <StackPanel Margin="22,0" VerticalAlignment="Center">
        <TextBlock Text="MATERIAIS" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Text="Crie materiais reutilizáveis com cor, textura, brilho e emissão"
                   FontSize="10" Foreground="#8A8E9E" Margin="0,3,0,0" />
      </StackPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="12,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="BIBLIOTECA" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="24" Height="24"
                    FontSize="14" Click="NewMaterial_Click" ToolTip="Criar material" />
          </DockPanel>
          <ListBox x:Name="MaterialList" Grid.Row="1" SelectionChanged="MaterialList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding FileName}" FontSize="9.5" Foreground="#7F8393" Margin="0,2,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel x:Name="EditorFields" Visibility="Collapsed">
          <DockPanel Margin="0,0,0,12">
            <Border x:Name="PreviewSwatch" DockPanel.Dock="Right" Width="62" Height="62" CornerRadius="10"
                    Background="#FFFFFF" BorderBrush="#3A3E4C" BorderThickness="1" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="NOME DO MATERIAL" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="NameField" />
            </StackPanel>
          </DockPanel>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="COR BASE (ALBEDO)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="AlbedoField" TextChanged="AlbedoField_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="COR DA EMISSÃO" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="EmissionField" TextChanged="AlbedoField_TextChanged" />
            </StackPanel>
          </Grid>

          <TextBlock Text="TEXTURA (OPCIONAL)" Style="{StaticResource FieldLabel}" />
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Procurar…" FontSize="10.5"
                    Padding="10,7" Click="BrowseTexture_Click" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Limpar" FontSize="10.5"
                    Padding="9,7" Click="ClearTexture_Click" Margin="6,0,0,0" />
            <TextBox x:Name="TextureField" />
          </DockPanel>

          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="BRILHO (0–1)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="SmoothnessField" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="FORÇA DA EMISSÃO" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="EmissionStrengthField" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="OPACIDADE (0–1)" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="OpacityField" />
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="REPETIÇÃO HORIZONTAL" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TilingXField" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="REPETIÇÃO VERTICAL" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="TilingYField" />
            </StackPanel>
          </Grid>

          <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <TextBlock Text="O material fica em Assets/Materials e pode ser aplicado a qualquer modelo importado. A textura escolhida aqui substitui a textura original do modelo."
                       FontSize="10" Foreground="#8E92A2" TextWrapping="Wrap" LineHeight="15" />
          </Border>

          <Button Style="{StaticResource GhostButton}" Content="Excluir material" Foreground="#F0A0A0"
                  HorizontalAlignment="Left" Padding="10,7" Margin="0,14,0,0" Click="DeleteMaterial_Click" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="20,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource PrimaryButton}" Content="Salvar material" Padding="16,9" Click="SaveMaterial_Click" />
          <Button Style="{StaticResource GhostButton}" Content="Aplicar ao modelo selecionado" Padding="12,8" Margin="8,0,0,0"
                  Click="ApplyMaterial_Click" />
          <Button Style="{StaticResource GhostButton}" Content="Fechar" Padding="12,8" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
