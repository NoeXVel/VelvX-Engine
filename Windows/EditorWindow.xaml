<Window x:Class="VelvX.Engine.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:VelvX.Engine.Rendering"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="VelvX Editor"
        Height="840" Width="1500" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource EditorBg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- Menu -->
    <Border Grid.Row="0" Background="#0B0C11" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button x:Name="MenuFileButton" Content="Arquivo" Tag="file" Style="{StaticResource GhostButton}" FontSize="12" Padding="11,4" Click="Menu_Click" />
          <Button x:Name="MenuEditButton" Content="Editar" Tag="edit" Style="{StaticResource GhostButton}" FontSize="12" Padding="11,4" Click="Menu_Click" />
          <Button x:Name="MenuProjectButton" Content="Projeto" Tag="project" Style="{StaticResource GhostButton}" FontSize="12" Padding="11,4" Click="Menu_Click" />
          <Button x:Name="MenuViewButton" Content="Janela" Tag="view" Style="{StaticResource GhostButton}" FontSize="12" Padding="11,4" Click="Menu_Click" />
          <Button x:Name="MenuHelpButton" Content="Ajuda" Tag="help" Style="{StaticResource GhostButton}" FontSize="12" Padding="11,4" Click="Menu_Click" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="VelvX Engine 0.2.0 · Forja" FontSize="9.5" Foreground="#5E6372" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Barra superior -->
    <Border Grid.Row="1" Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="←" ToolTip="Voltar ao launcher" Click="Back_Click" Margin="0,0,10,0" />
          <Border Width="30" Height="30" CornerRadius="9" Background="#2A2340">
            <TextBlock Text="V" Foreground="{StaticResource Accent}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProjectNameText" Text="Projeto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border x:Name="ModeBadgeBorder" Background="#28213F" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadgeText" Text="3D" FontSize="9" FontWeight="Bold" Foreground="#C9B8FF" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="ProjectPathText" Text="" FontSize="9.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="560" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Content="⚙  Configurações" Click="OpenSettings_Click" Margin="0,0,4,0" ToolTip="Inputs, renderização, ambiente e cenas" />
          <Button Style="{StaticResource GhostButton}" Content="Salvar" Click="Save_Click" Margin="0,0,4,0" />
          <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  Executar" Click="Play_Click" Margin="6,0,0,0" />
          <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}" Content="■  Parar" Click="Stop_Click" Margin="6,0,0,0" Visibility="Collapsed" Background="#4A2530" Foreground="#FFD6D6" />
          <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="12,0" />
          <Button Style="{StaticResource IconButton}" Content="◈" ToolTip="Resetar câmera" Click="ResetCamera_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Área principal -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <!-- Hierarquia -->
      <Border Grid.Column="0" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="12,12,12,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel>
            <TextBlock Text="HIERARQUIA" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            <Button x:Name="DeleteHierarchyButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×" Width="24" Height="24" FontSize="14" Click="DeleteObject_Click" ToolTip="Excluir objeto selecionado" Margin="2,0,0,0" />
            <Button x:Name="DuplicateHierarchyButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⧉" Width="24" Height="24" FontSize="12" Click="DuplicateObject_Click" ToolTip="Duplicar objeto" Margin="2,0,0,0" />
            <Button x:Name="AddObjectButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="24" Height="24" FontSize="15" Click="AddObject_Click" ToolTip="Adicionar objeto à cena" Margin="2,0,0,0" />
          </DockPanel>

          <Border Grid.Row="1" Background="#12141A" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="7" Margin="0,10,0,6" Padding="8,5">
            <DockPanel>
              <TextBlock Text="⌕" Foreground="#6F7382" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBox x:Name="HierarchySearchBox" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="20"
                       FontSize="11.5" Foreground="{StaticResource Text}" VerticalContentAlignment="Center"
                       TextChanged="HierarchySearch_TextChanged" />
            </DockPanel>
          </Border>
          <TextBlock Grid.Row="1" Text="Filtrar objetos..." x:Name="HierarchySearchHint" FontSize="11" Foreground="#5C6170" Margin="24,14,0,0" IsHitTestVisible="False" />

          <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button x:Name="SceneSelectorButton" Style="{StaticResource GhostButton}" Padding="9,6" Click="SceneSelector_Click" HorizontalAlignment="Stretch" ToolTip="Trocar de cena">
              <DockPanel>
                <TextBlock Text="◇" Foreground="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="▾" Foreground="#757A8A" DockPanel.Dock="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="SceneNameText" Text="Main" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Button>
            <Button Style="{StaticResource IconButton}" Content="+" Width="26" Height="28" Margin="5,0,0,0" Click="NewScene_Click" ToolTip="Criar nova cena" />
          </DockPanel>

          <ListBox x:Name="HierarchyList" Grid.Row="3" SelectionChanged="Hierarchy_SelectionChanged"
                   AllowDrop="True" Drop="HierarchyList_Drop" PreviewMouseLeftButtonDown="HierarchyList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="HierarchyList_PreviewMouseMove">
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Duplicar objeto" Click="DuplicateObject_Click" />
                <MenuItem Header="Criar prefab a partir do objeto" Click="CreatePrefabFromObject_Click" />
                <MenuItem Header="Definir como câmera do jogo" Click="SetAsGameCamera_Click" />
                <MenuItem Header="Excluir objeto" Click="DeleteObject_Click" />
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Foreground="#B7A4FF" FontSize="13" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Type}" FontSize="9" Foreground="#707585" Margin="0,1,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="○" FontSize="10" Foreground="#5A5E6D" VerticalAlignment="Center" ToolTip="Objeto visível no editor" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,10" />
            <DockPanel>
              <TextBlock x:Name="HierarchyCountText" Text="0" DockPanel.Dock="Right" FontSize="9.5" Foreground="#6F7382" VerticalAlignment="Center" />
              <TextBlock Text="CENAS CARREGADAS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="LoadedScenesText" Text="Fora de execução." FontSize="10" Foreground="#8A8E9E" TextWrapping="Wrap" LineHeight="15" Margin="0,2,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

      <!-- Viewport + painéis inferiores -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="310" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A0B10" ClipToBounds="True">
          <Grid x:Name="ViewportHost" AllowDrop="True" Drop="ViewportHost_Drop" DragOver="ViewportHost_DragOver">
            <rendering:Scene3DView x:Name="View3D" />
            <rendering:Scene2DView x:Name="View2D" Visibility="Collapsed" />

            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Background="#D911131A" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="8" Padding="10,6" IsHitTestVisible="False">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="◇" Foreground="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ViewportSceneText" Text="Main" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#28213F" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ViewportModeText" Text="3D" FontSize="8.5" FontWeight="Bold" Foreground="#CBBAFF" />
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16">
              <Button Style="{StaticResource GhostButton}" Content="Focar" FontSize="10.5" Padding="10,5" Click="FocusSelected_Click" ToolTip="Centralizar a câmera no objeto selecionado" />
              <Button Style="{StaticResource GhostButton}" Content="Resetar" FontSize="10.5" Padding="10,5" Click="ResetCamera_Click" Margin="4,0,0,0" />
            </StackPanel>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Background="#B311131A" CornerRadius="7" Padding="9,5" IsHitTestVisible="False">
              <TextBlock x:Name="ViewportHintText" Text="WASD mover · botão direito orbitar · setas coloridas movem o objeto" FontSize="10" Foreground="#8D91A1" />
            </Border>

            <Border x:Name="PlayOverlay" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16,58,16,0" Background="#1E3A2F" BorderBrush="#2F6B52" BorderThickness="1" CornerRadius="20" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#6EE7B7" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="EXECUTANDO" FontSize="9.5" FontWeight="Bold" Foreground="#A7F3D0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="292" />
          </Grid.ColumnDefinitions>

          <!-- Editor de script -->
          <Border Grid.Column="0" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="EDITOR DE SCRIPT" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                  <Border Background="#1B1E27" CornerRadius="5" Padding="7,3" Margin="8,0,0,0">
                    <TextBlock x:Name="ScriptFileText" Text="Main.velv" FontSize="10" Foreground="#AFA6C9" />
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="ScriptDirtyText" Text="" Foreground="{StaticResource Warning}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <Button Style="{StaticResource GhostButton}" Content="Ajuda" Padding="9,5" FontSize="11" Click="ToggleHelp_Click" Margin="0,0,4,0" />
                  <Button Style="{StaticResource GhostButton}" Content="Abrir" Padding="9,5" FontSize="11" Click="OpenScript_Click" Margin="0,0,4,0" ToolTip="Abrir outro script do projeto" />
                  <Button Style="{StaticResource GhostButton}" Content="Salvar" Padding="9,5" FontSize="11" Click="Save_Click" />
                </StackPanel>
              </DockPanel>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <avalonedit:TextEditor x:Name="ScriptEditor"
                                       Background="#0E1015" Foreground="#DDD8EE"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                       ShowLineNumbers="True"
                                       Padding="8,7"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       WordWrap="False" />
                <Border x:Name="ScriptHelpPanel" Grid.Column="1" Width="248" Background="#101218"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="REFERÊNCIA RÁPIDA" Style="{StaticResource SectionLabel}" />
                      <TextBlock Text="CICLO DE VIDA" FontSize="9" FontWeight="Bold" Foreground="#757A8A" Margin="0,2,0,4" />
                      <TextBlock Text="func Main()  → roda uma vez" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="func InGame() → a cada quadro" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="this → objeto do componente" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" Margin="0,0,0,10" />

                      <TextBlock Text="ENTRADA" FontSize="9" FontWeight="Bold" Foreground="#757A8A" Margin="0,0,0,4" />
                      <TextBlock Text="game.get_input(&quot;pular&quot;)" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="game.get_input_vectors(...)" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="game.delta_time" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" Margin="0,0,0,10" />

                      <TextBlock Text="CENAS / STREAMING" FontSize="9" FontWeight="Bold" Foreground="#757A8A" Margin="0,0,0,4" />
                      <TextBlock Text="Scene(&quot;Fase 2&quot;).load()" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="Scene(&quot;Fase 1&quot;).unload()" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="Scenes.set_active(&quot;Fase 2&quot;)" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" Margin="0,0,0,10" />

                      <TextBlock Text="OBJETOS E CONSOLE" FontSize="9" FontWeight="Bold" Foreground="#757A8A" Margin="0,0,0,4" />
                      <TextBlock Text="Assets.pathObject(&quot;Player&quot;)" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="console.show(&quot;olá&quot;)" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="console.warn / console.error" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" Margin="0,0,0,10" />

                      <TextBlock Text="SINTAXE" FontSize="9" FontWeight="Bold" Foreground="#757A8A" Margin="0,0,0,4" />
                      <TextBlock Text="var nome: Tipo = valor" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="if / else / while / return" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" />
                      <TextBlock Text="## comentário" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#8EE3A8" />
                      <TextBlock Text="Vector2, Vector3, math" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="#D8D4E4" Margin="0,0,0,10" />

                      <Border Background="#171A22" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="7" Padding="8,7">
                        <TextBlock Text="Os Inputs são definidos em Projeto → Configurações → Entradas. Use os nomes criados lá nos scripts." FontSize="9.5" Foreground="#9A9EAD" TextWrapping="Wrap" LineHeight="14" />
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

          <!-- Recursos -->
          <Border Grid.Column="2" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Margin="12,0">
                <TextBlock Text="RECURSOS" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <Button x:Name="ResourceNewButton" Style="{StaticResource IconButton}" Content="+" Width="24" Height="24" FontSize="14" Click="ResourceNew_Click" ToolTip="Criar prefab ou pasta" Margin="0,0,3,0" />
                  <Button Style="{StaticResource IconButton}" Content="↻" Width="24" Height="24" FontSize="12" Click="RefreshResources_Click" ToolTip="Atualizar recursos" />
                </StackPanel>
              </DockPanel>
              <TreeView x:Name="ResourceTree" Grid.Row="1" Padding="8,2"
                        AllowDrop="True" Drop="ResourceTree_Drop"
                        MouseDoubleClick="ResourceTree_MouseDoubleClick"
                        PreviewMouseLeftButtonDown="ResourceTree_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ResourceTree_PreviewMouseMove"
                        ContextMenuOpening="ResourceTree_ContextMenuOpening">
                <TreeView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Abrir / instanciar" Click="ResourceOpen_Click" />
                    <MenuItem Header="Excluir arquivo" Click="ResourceDelete_Click" />
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>
              <Border Grid.Row="2" Background="#101218" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,7">
                <TextBlock Text="Arraste um objeto da hierarquia para Prefabs para criar um prefab. Dê dois cliques para usar." FontSize="9" Foreground="#6F7382" TextWrapping="Wrap" LineHeight="13" />
              </Border>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

          <!-- Console -->
          <Border Grid.Column="4" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="12,0">
                <TextBlock Text="SAÍDA" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Limpar" FontSize="10" Padding="8,5" Click="ClearConsole_Click" />
              </DockPanel>
              <ListBox x:Name="ConsoleList" Grid.Row="1" Background="#0B0D12" Padding="8,4" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" Foreground="{Binding Foreground}" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

      <!-- Inspetor -->
      <Border Grid.Column="4" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,20">
            <TextBlock Text="INSPETOR" Style="{StaticResource SectionLabel}" />

            <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel>
                <TextBlock x:Name="InspectorName" Text="Nenhum objeto selecionado" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InspectorType" Text="Selecione um objeto na hierarquia" FontSize="10" Foreground="#8A8E9E" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="InspectorFields" Visibility="Collapsed" Margin="0,14,0,0">
              <TextBlock Text="NOME" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="NameField" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" Margin="0,0,0,12" />

              <TextBlock Text="POSIÇÃO" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="X" FontSize="9" Foreground="#FF6A7E" Margin="2,0,0,3" />
                  <TextBox x:Name="PosXField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Y" FontSize="9" Foreground="#62E29A" Margin="2,0,0,3" />
                  <TextBox x:Name="PosYField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel x:Name="PosZPanel" Grid.Column="4">
                  <TextBlock Text="Z" FontSize="9" Foreground="#5C9EFF" Margin="2,0,0,3" />
                  <TextBox x:Name="PosZField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
              </Grid>

              <TextBlock Text="ROTAÇÃO (GRAUS)" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RotXField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                <TextBox x:Name="RotYField" Grid.Column="2" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                <TextBox x:Name="RotZField" Grid.Column="4" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </Grid>

              <TextBlock Text="ESCALA" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="7" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScaleXField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                <TextBox x:Name="ScaleYField" Grid.Column="2" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                <TextBox x:Name="ScaleZField" Grid.Column="4" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </Grid>

              <StackPanel x:Name="SizePanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="TAMANHO (2D)" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SizeXField" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  <TextBox x:Name="SizeYField" Grid.Column="2" FontSize="11.5" Padding="7,5" MinHeight="28" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </Grid>
              </StackPanel>

              <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left" Width="96">
                  <TextBlock Text="COR" Style="{StaticResource FieldLabel}" />
                  <Border x:Name="ColorSwatch" Width="34" Height="28" CornerRadius="6" Background="#A98BFF" BorderBrush="#3A3E4C" BorderThickness="1" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBox x:Name="ColorField" VerticalAlignment="Bottom" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </DockPanel>

              <DockPanel Margin="0,0,0,10">
                <CheckBox x:Name="VisibleCheck" Content="Visível" Click="VisibleCheck_Click" VerticalAlignment="Center" />
                <TextBlock Text="TAG" Style="{StaticResource FieldLabel}" Margin="14,0,6,0" VerticalAlignment="Center" />
                <TextBox x:Name="TagField" FontSize="11" Padding="7,4" MinHeight="26" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </DockPanel>

              <!-- Específico por tipo -->
              <StackPanel x:Name="ModelPanel" Visibility="Collapsed" Margin="0,4,0,10">
                <TextBlock Text="MODELO 3D" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,7">
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Importar" FontSize="10" Padding="8,5" Click="ImportModel_Click" Margin="5,0,0,0" />
                  <TextBox x:Name="ModelPathField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </DockPanel>
                <TextBlock Text="ANIMAÇÃO (NOME OU VAZIO)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AnimationField" FontSize="10.5" Margin="0,0,0,7" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="VELOCIDADE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AnimationSpeedField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                  <CheckBox x:Name="AnimationLoopCheck" Grid.Column="2" Content="Repetir" Click="AnimationLoop_Click" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </Grid>
              </StackPanel>

              <StackPanel x:Name="SpritePanel" Visibility="Collapsed" Margin="0,4,0,10">
                <TextBlock Text="SPRITE / GIF" Style="{StaticResource FieldLabel}" />
                <DockPanel Margin="0,0,0,7">
                  <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Importar" FontSize="10" Padding="8,5" Click="ImportSprite_Click" Margin="5,0,0,0" />
                  <TextBox x:Name="SpritePathField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </DockPanel>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="COLUNAS" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SpriteColumnsField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="LINHAS" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SpriteRowsField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="FPS" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SpriteFpsField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="SpriteLoopCheck" Content="Repetir animação" Click="SpriteLoop_Click" />
              </StackPanel>

              <StackPanel x:Name="LightPanel" Visibility="Collapsed" Margin="0,4,0,10">
                <TextBlock Text="LUZ" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="INTENSIDADE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="IntensityField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="ALCANCE" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="RangeField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                  </StackPanel>
                </Grid>
              </StackPanel>

              <StackPanel x:Name="VolumePanel" Visibility="Collapsed" Margin="0,4,0,10">
                <TextBlock Text="VOLUME" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="INTENSIDADE" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="VolumeIntensityField" FontSize="10.5" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </StackPanel>

              <!-- Componentes -->
              <Border Height="1" Background="{StaticResource Line}" Margin="0,6,0,10" />
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="COMPONENTES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                <Button x:Name="AddComponentButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="24" Height="24" FontSize="14" Click="AddComponent_Click" ToolTip="Adicionar componente" />
              </DockPanel>
              <StackPanel x:Name="ComponentsPanel" />

              <!-- Script principal -->
              <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,10" />
              <TextBlock Text="SCRIPT DO OBJETO" Style="{StaticResource FieldLabel}" />
              <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="7" Padding="9,7">
                <TextBlock x:Name="ScriptPathText" Text="Sem script vinculado" FontSize="10" Foreground="#A9A4BD" TextTrimming="CharacterEllipsis" />
              </Border>
              <Button Style="{StaticResource GhostButton}" Content="Ir para o script" HorizontalAlignment="Left" Padding="9,6" Margin="0,8,0,0" Click="GoToScript_Click" />

              <Button Content="Remover objeto" Background="#2A1A1E" Foreground="#F0A0A0" Padding="10,8" Margin="0,16,0,0" Click="DeleteObject_Click" />
            </StackPanel>

            <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="CICLO DE VIDA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBlock Text="Main() roda uma vez. InGame() roda a cada quadro. Componentes de script usam this para acessar o objeto." FontSize="9.5" Foreground="#838797" TextWrapping="Wrap" LineHeight="15" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Barra de status -->
    <Border Grid.Row="3" Background="#0A0B10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#6B7280" Margin="0,0,7,0" />
          <TextBlock x:Name="StatusText" Text="PRONTO" FontSize="9.5" FontWeight="SemiBold" Foreground="#8A8E9E" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="VelvX Language · 0.2.0" FontSize="9.5" Foreground="#5E6372" Margin="0,0,16,0" />
          <TextBlock x:Name="FpsText" Text="" FontSize="9.5" Foreground="#5E6372" Margin="0,0,16,0" />
          <TextBlock x:Name="StatusLineText" Text="Ln 1, Col 1" FontSize="9.5" Foreground="#5E6372" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Popups -->
    <Popup x:Name="MenuPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0">
        <StackPanel x:Name="MenuPopupPanel" Width="238" />
      </Border>
    </Popup>

    <Popup x:Name="ScenePopup" PlacementTarget="{Binding ElementName=SceneSelectorButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0">
        <StackPanel x:Name="SceneMenuPanel" Width="246" />
      </Border>
    </Popup>

    <Popup x:Name="AddObjectPopup" PlacementTarget="{Binding ElementName=AddObjectButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0">
        <StackPanel x:Name="AddObjectMenu" Width="204" />
      </Border>
    </Popup>

    <Popup x:Name="AddComponentPopup" PlacementTarget="{Binding ElementName=AddComponentButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0">
        <StackPanel x:Name="AddComponentMenu" Width="224" />
      </Border>
    </Popup>

    <Popup x:Name="ResourceNewPopup" PlacementTarget="{Binding ElementName=ResourceNewButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,6,0,0">
        <StackPanel x:Name="ResourceNewMenu" Width="224" />
      </Border>
    </Popup>
  </Grid>
</Window>
