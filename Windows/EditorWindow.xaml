<Window x:Class="VelvX.Engine.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:VelvX.Engine.Rendering"
        Title="VelvX Editor"
        Height="700" Width="1180" MinHeight="560" MinWidth="940"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource EditorBg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- Barra superior -->
    <Border Grid.Row="0" Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="12,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Content="←" ToolTip="Voltar ao launcher" Click="Back_Click" Margin="0,0,10,0" />
          <Border Width="30" Height="30" CornerRadius="9" Background="#2A2340">
            <TextBlock Text="V" Foreground="{StaticResource Accent}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="ProjectNameText" Text="Projeto" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border x:Name="ModeBadgeBorder" Background="#28213F" CornerRadius="5" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ModeBadgeText" Text="3D" FontSize="9" FontWeight="Bold" Foreground="#C9B8FF" />
              </Border>
            </StackPanel>
            <TextBlock x:Name="ProjectPathText" Text="" FontSize="9.5" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Style="{StaticResource GhostButton}" Content="Salvar" Click="Save_Click" Margin="0,0,4,0" />
          <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="▶  Executar" Click="Play_Click" Margin="6,0,0,0" />
          <Button x:Name="StopButton" Style="{StaticResource PrimaryButton}" Content="■  Parar" Click="Stop_Click" Margin="6,0,0,0" Visibility="Collapsed" Background="#4A2530" Foreground="#FFD6D6" />
          <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="12,0" />
          <Button Style="{StaticResource IconButton}" Content="◈" ToolTip="Resetar câmera" Click="ResetCamera_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Área principal -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="292" />
      </Grid.ColumnDefinitions>

      <!-- Hierarquia -->
      <Border Grid.Column="0" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <Grid Margin="12,14,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel>
            <TextBlock Text="HIERARQUIA" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
            <Button x:Name="AddObjectButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="+" Width="26" Height="26" FontSize="15" Click="AddObject_Click" ToolTip="Adicionar objeto à cena" />
          </DockPanel>

          <ListBox x:Name="HierarchyList" Grid.Row="1" Margin="0,8,0,0" SelectionChanged="Hierarchy_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Glyph}" Foreground="#B7A4FF" FontSize="13" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Type}" FontSize="9" Foreground="#707585" Margin="0,1,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,10,0,10" />
            <TextBlock Text="CENA ATIVA" Style="{StaticResource SectionLabel}" />
            <Border Background="#171A22" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <DockPanel>
                <TextBlock Text="◇" Foreground="{StaticResource Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SceneNameText" Text="Main" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

      <!-- Viewport + parte inferior -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="248" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A0B10" ClipToBounds="True">
          <Grid>
            <rendering:Scene3DView x:Name="View3D" />
            <rendering:Scene2DView x:Name="View2D" Visibility="Collapsed" />

            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Background="#D911131A" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="8" Padding="10,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="◇" Foreground="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ViewportSceneText" Text="Main" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#28213F" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ViewportModeText" Text="3D" FontSize="8.5" FontWeight="Bold" Foreground="#CBBAFF" />
                </Border>
              </StackPanel>
            </Border>

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16" Background="#B311131A" CornerRadius="7" Padding="9,5">
              <TextBlock x:Name="ViewportHintText" Text="Botão direito: orbitar   ·   botão do meio: mover   ·   scroll: zoom" FontSize="10" Foreground="#8D91A1" />
            </Border>

            <Border x:Name="PlayOverlay" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="16" Background="#1E3A2F" BorderBrush="#2F6B52" BorderThickness="1" CornerRadius="20" Padding="12,6">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#6EE7B7" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="EXECUTANDO" FontSize="9.5" FontWeight="Bold" Foreground="#A7F3D0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="390" />
          </Grid.ColumnDefinitions>

          <!-- Script -->
          <Border Grid.Column="0" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="SCRIPT" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                  <Border Background="#1B1E27" CornerRadius="5" Padding="7,3" Margin="8,0,0,0">
                    <TextBlock x:Name="ScriptFileText" Text="Main.velv" FontSize="10" Foreground="#AFA6C9" />
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                  <TextBlock x:Name="ScriptDirtyText" Text="" Foreground="{StaticResource Warning}" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <Button Style="{StaticResource GhostButton}" Content="Salvar" Padding="10,6" Click="Save_Click" />
                </StackPanel>
              </DockPanel>

              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="#0E1015" BorderBrush="{StaticResource Line}" BorderThickness="0,1,1,0" ClipToBounds="True">
                  <TextBlock x:Name="LineNumbers" Text="1" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#4F5464" TextAlignment="Right" Margin="0,9,10,0">
                    <TextBlock.RenderTransform>
                      <TranslateTransform x:Name="LineNumbersTransform" />
                    </TextBlock.RenderTransform>
                  </TextBlock>
                </Border>

                <TextBox x:Name="ScriptBox" Grid.Column="1" Background="#0E1015" BorderThickness="0" Padding="10,9"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="#DDD8EE"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextChanged="ScriptBox_TextChanged" PreviewKeyDown="ScriptBox_PreviewKeyDown" />
              </Grid>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

          <!-- Console -->
          <Border Grid.Column="2" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <DockPanel Margin="12,0">
                <TextBlock Text="SAÍDA" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Limpar" FontSize="10" Padding="8,5" Click="ClearConsole_Click" />
              </DockPanel>
              <ListBox x:Name="ConsoleList" Grid.Row="1" Background="#0B0D12" Padding="8,4" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Display}" Foreground="{Binding Foreground}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#0A0B10" ShowsPreview="False" />

      <!-- Inspetor -->
      <Border Grid.Column="4" Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,16,16,20">
            <TextBlock Text="INSPETOR" Style="{StaticResource SectionLabel}" />

            <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="10" Padding="12,10">
              <StackPanel>
                <TextBlock x:Name="InspectorName" Text="Nenhum objeto selecionado" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InspectorType" Text="Selecione um objeto na hierarquia" FontSize="10" Foreground="#8A8E9E" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>

            <StackPanel x:Name="InspectorFields" Visibility="Collapsed" Margin="0,16,0,0">
              <TextBlock Text="NOME" Style="{StaticResource FieldLabel}" />
              <TextBox x:Name="NameField" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" Margin="0,0,0,14" />

              <TextBlock Text="POSIÇÃO" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="X" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="PosXField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Y" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="PosYField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel x:Name="PosZPanel" Grid.Column="4">
                  <TextBlock Text="Z" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="PosZField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
              </Grid>

              <TextBlock Text="ESCALA" Style="{StaticResource FieldLabel}" />
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="X" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="ScaleXField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Y" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="ScaleYField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
                <StackPanel x:Name="ScaleZPanel" Grid.Column="4">
                  <TextBlock Text="Z" FontSize="9" Foreground="#636878" Margin="2,0,0,4" />
                  <TextBox x:Name="ScaleZField" FontSize="12" Padding="8,6" MinHeight="30" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
                </StackPanel>
              </Grid>

              <TextBlock Text="COR" Style="{StaticResource FieldLabel}" />
              <DockPanel Margin="0,0,0,14">
                <Border x:Name="ColorSwatch" Width="34" Height="34" CornerRadius="7" Background="#A98BFF" BorderBrush="#3A3E4C" BorderThickness="1" />
                <TextBox x:Name="ColorField" Margin="8,0,0,0" LostFocus="InspectorField_LostFocus" KeyDown="InspectorField_KeyDown" />
              </DockPanel>

              <TextBlock Text="SCRIPT" Style="{StaticResource FieldLabel}" />
              <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="7" Padding="9,7">
                <TextBlock x:Name="ScriptPathText" Text="Scripts/Main.velv" FontSize="10.5" Foreground="#A9A4BD" TextTrimming="CharacterEllipsis" />
              </Border>
              <Button Style="{StaticResource GhostButton}" Content="Ir para o script" HorizontalAlignment="Left" Padding="9,6" Margin="0,8,0,0" Click="GoToScript_Click" />

              <Button Content="Remover objeto" Background="#2A1A1E" Foreground="#F0A0A0" Padding="10,8" Margin="0,18,0,0" Click="DeleteObject_Click" />
            </StackPanel>

            <Border Background="#141720" BorderBrush="#2A2D38" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="CICLO DE VIDA" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBlock Text="Main() roda uma vez ao executar. InGame() roda a cada quadro e recebe o input do jogo." FontSize="10" Foreground="#838797" TextWrapping="Wrap" LineHeight="16" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Barra de status -->
    <Border Grid.Row="2" Background="#0A0B10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="12,0" LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#6B7280" Margin="0,0,7,0" />
          <TextBlock x:Name="StatusText" Text="PRONTO" FontSize="9.5" FontWeight="SemiBold" Foreground="#8A8E9E" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="VelvX Language · 0.1.0" FontSize="9.5" Foreground="#5E6372" Margin="0,0,16,0" />
          <TextBlock x:Name="FpsText" Text="" FontSize="9.5" Foreground="#5E6372" Margin="0,0,16,0" />
          <TextBlock x:Name="StatusLineText" Text="Ln 1, Col 1" FontSize="9.5" Foreground="#5E6372" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Popup x:Name="AddObjectPopup" PlacementTarget="{Binding ElementName=AddObjectButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Border Background="#1B1E27" BorderBrush="#333744" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,8,0,0">
        <StackPanel x:Name="AddObjectMenu" Width="184" />
      </Border>
    </Popup>
  </Grid>
</Window>
