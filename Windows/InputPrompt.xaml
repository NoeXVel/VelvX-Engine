<Window x:Class="VelvX.Engine.Windows.InputPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VelvX"
        Width="410" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
  <Border Padding="22,20">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="Nome" FontSize="15" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageText" Text="" FontSize="11" Foreground="#9A9EAD" TextWrapping="Wrap" Margin="0,5,0,14" />
      <TextBox x:Name="ValueBox" FontSize="12.5" KeyDown="ValueBox_KeyDown" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="Cancel_Click" Margin="0,0,8,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="Confirmar" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
