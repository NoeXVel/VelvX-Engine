<Window x:Class="VelvX.Engine.Windows.LanguageDocsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Documentação da VelvX Language"
        Width="980" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource EditorBg}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="62" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>

    <Border Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="22,0" VerticalAlignment="Center">
        <Border DockPanel.Dock="Right" Background="#28213F" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" Text="VelvX Language" FontSize="10" FontWeight="SemiBold" Foreground="#CBBAFF" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DOCUMENTAÇÃO DA VELVX LANGUAGE" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="Sintaxe, variáveis, funções, laços, vetores e APIs da Engine" FontSize="10" Foreground="#8A8E9E" Margin="0,3,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="{StaticResource PanelDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,12">
          <TextBlock DockPanel.Dock="Top" Text="CONTEÚDO" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
          <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                   SelectionChanged="SectionList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Title}" FontSize="11.5" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <FlowDocumentScrollViewer x:Name="DocViewer" Grid.Column="1" Background="#0F1117"
                                VerticalScrollBarVisibility="Auto" Padding="26,18,30,24"
                                IsToolBarVisible="False" />
    </Grid>

    <Border Grid.Row="2" Background="#11131A" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <DockPanel Margin="20,0">
        <TextBlock DockPanel.Dock="Left" Text="Dica: os exemplos podem ser copiados para Scripts/Main.velv." FontSize="10"
                   Foreground="#7F8496" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Fechar" Padding="14,7"
                VerticalAlignment="Center" Click="Close_Click" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
